{
  "name": "travel-days",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @travel-days/api",
    "dev:mini-app": "npm run dev -w @travel-days/mini-app",
    "dev:init-data": "npm run dev:init-data -w @travel-days/api --",
    "build:mini-app": "npm run build -w @travel-days/mini-app",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run db:migrate -w @travel-days/api",
    "test": "vitest run",
    "test:unit": "vitest run --project shared --project api-unit --project mini-app",
    "test:integration": "vitest run --project api-integration",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
