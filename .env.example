# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://travel_days:travel_days@localhost:5433/travel_days
# Integration tests wipe this database; its name must end with _test
TEST_DATABASE_URL=postgres://travel_days:travel_days@localhost:5433/travel_days_test

# Token from @BotFather, format <digits>:<secret>
BOT_TOKEN=
# Maximum age of Telegram initData (auth_date), seconds
INIT_DATA_MAX_AGE_SECONDS=86400
